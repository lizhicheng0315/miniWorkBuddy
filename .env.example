# 服务端口
PORT=3000

# 数据存储目录（首次启动自动创建）
DATA_DIR=./data

# 时区
TZ=Asia/Shanghai

# ===== LLM（OpenAI 兼容接口，DeepSeek / Moonshot / 自部署均可）=====
# 重要：你需要自己去 https://platform.deepseek.com 申请一个 key 填到这里
# 或者用任意 OpenAI 兼容服务：把 baseURL 和 model 一起改
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=__SET_ME__
LLM_MODEL=deepseek-chat
# 推理强度（可选）：low / medium / high；留空则不发送 reasoning_effort
LLM_REASONING_EFFORT=
# NLP 脱机降级（不依赖 LLM）：true=LLM 不可用时走关键词匹配；false=严格等 LLM
# 默认 true：没有 key 也能用（仅支持有限的自然语言）
NLP_OFFLINE_FALLBACK=true

# ===== 通知 =====
# 是否同时播放系统提示音
NOTIFY_SOUND=true
# 后台任务 / automation 完成或失败时是否发桌面通知
NOTIFY_TASKS=true

# ===== LLM 调用行为 =====
# 单次请求超时（毫秒）
LLM_TIMEOUT_MS=30000
# 最大重试次数（指数退避：500/1000/2000ms）
LLM_MAX_RETRIES=3

# Microsoft MarkItDown 文档解析（PDF / Word / PPT / Excel 等）
MARKITDOWN_PYTHON=python
MARKITDOWN_HOME=./.tools/markitdown
MARKITDOWN_MAX_MB=25
MARKITDOWN_TIMEOUT_MS=90000
MARKITDOWN_MAX_CHARS=120000

# ===== 认证 =====
# 是否启用多用户认证（强烈建议生产环境启用）
AUTH_ENABLED=true
# 首次启动自动创建的 admin 账户（仅在没有用户时生效）
BOOTSTRAP_USER=admin
# 留空则在启动日志中打印一个随机生成的密码
BOOTSTRAP_PASSWORD=

# ===== 联网搜索 =====
# 可选：Bing Web Search API key（免费订阅 https://www.microsoft.com/en-us/bing/apis/bing-web-search-api）
# 配置后搜索优先用 Bing（质量更好）；不配置则用免费的 DuckDuckGo
BING_SEARCH_KEY=

# ===== Computer Use（Windows）=====
# 允许通过聊天/面板执行任意 PowerShell 命令或启动程序（默认关闭，危险能力）
COMPUTER_ALLOW_SHELL=false

# ===== Browser Use =====
# true=无头模式（不弹出浏览器窗口）；false=用户可见的浏览器窗口
BROWSER_HEADLESS=false
# 手动指定浏览器可执行文件（默认自动找 Edge/Chrome/Chromium）
BROWSER_EXECUTABLE=

# ===== 日志 =====
LOG_TO_FILE=true

# ===== 限流（每窗口允许次数） =====
RATELIMIT_LOGIN=20
RATELIMIT_API=300
RATELIMIT_AI=30

# ===== HTTPS（可选）=====
TLS_ENABLED=false
TLS_KEY=./certs/server.key
TLS_CERT=./certs/server.crt
